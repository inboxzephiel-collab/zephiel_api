{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zephiel-api",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "cede181f61b541c28a1bf0f7e790ddbe"
    }
  ],
  "observability": {
    "enabled": true
  }
}
