{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zephiel-api",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "cede181f61b541c28a1bf0f7e790ddbe",
      // Only for local emulation (wrangler dev) and to satisfy the deploy tool's binding check — the
      // deployed Worker uses the real Hyperdrive config above, never this. No real credentials here.
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres"
    }
  ],
  // `wrangler preview` (used by non-production branch builds) requires an explicit previews binding for
  // Hyperdrive; without it the preview deploy fails with "missing a `previews` block". Point it at the
  // same Hyperdrive so branch previews run against the real database and are actually testable.
  // Production (`wrangler deploy` from main) uses the top-level `hyperdrive` binding above, unaffected.
  "previews": {
    "hyperdrive": [
      {
        "binding": "HYPERDRIVE",
        "id": "cede181f61b541c28a1bf0f7e790ddbe"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
