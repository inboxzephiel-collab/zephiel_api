{
  "name": "zephiel-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/embed-schema.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:seed": "tsx scripts/seed.mts",
    "db:reset": "tsx scripts/reset.mts",
    "test:e2e": "tsx scripts/e2e.mts",
    "admin:password": "tsx scripts/set-password.mts",
    "user:adjust": "tsx scripts/adjust-user.mts",
    "audit": "tsx scripts/audit.mts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.3.0",
    "next": "^16.3.3",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
